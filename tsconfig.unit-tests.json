{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": ".unit-test-dist",
    "rootDir": "src",
    "module": "node16",
    "target": "es2020",
    "moduleResolution": "node16",
    "incremental": false,
    "isolatedModules": false,
    "jsx": "react-jsx"
  },
  "include": ["src/**/*.test.ts"],
  "exclude": ["node_modules", "src/lib/analytics/**/*.test.ts"]
}
